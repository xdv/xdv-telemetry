// Description:
//   xdv-telemetry: deterministic local and distributed aggregation.

forge XdvTelemetryAggregation {

    const STATUS_OK: UInt32 = 0;

    const FLUSH_NO: UInt64 = 0;
    const FLUSH_YES: UInt64 = 1;

    proc K::local_flush_decision(last_flush_l: UInt64, now_l: UInt64, flush_interval_l: UInt64) {
        if flush_interval_l == 0 {
            return FLUSH_NO;
        } else {
            if now_l < last_flush_l {
                return FLUSH_NO;
            } else {
                if (now_l - last_flush_l) >= flush_interval_l {
                    return FLUSH_YES;
                } else {
                    return FLUSH_NO;
                }
            }
        }
    }

    proc K::local_aggregate_sum3(v1: UInt64, v2: UInt64, v3: UInt64) {
        return v1 + v2 + v3;
    }

    proc K::local_aggregate_avg3(v1: UInt64, v2: UInt64, v3: UInt64) {
        let total = local_aggregate_sum3(v1, v2, v3);
        return total / 3;
    }

    proc K::local_buffer_epoch(domain: UInt64, logical_timestamp: UInt64, flush_interval_l: UInt64) {
        let d = XdvTelemetryContracts::K::is_domain_valid(domain);
        if d == STATUS_OK {
            if logical_timestamp == 0 {
                return 0;
            } else {
                if flush_interval_l == 0 {
                    return 0;
                } else {
                    return logical_timestamp / flush_interval_l;
                }
            }
        } else {
            return 0;
        }
    }

    proc K::distributed_merge_key(logical_timestamp: UInt64, node_id: UInt64, source_id: UInt64, metric_id: UInt64) {
        return XdvTelemetrySchema::K::metric_order_key(logical_timestamp, node_id, source_id, metric_id);
    }

    proc K::distributed_choose_first(key_a: UInt64, node_a: UInt64, key_b: UInt64, node_b: UInt64) {
        if key_a == 0 {
            if key_b == 0 {
                return 0;
            } else {
                return 2;
            }
        } else {
            if key_b == 0 {
                return 1;
            } else {
                if key_a < key_b {
                    return 1;
                } else {
                    if key_b < key_a {
                        return 2;
                    } else {
                        if node_a <= node_b {
                            return 1;
                        } else {
                            return 2;
                        }
                    }
                }
            }
        }
    }

    proc K::distributed_merge_token(logical_timestamp_a: UInt64, node_a: UInt64, source_a: UInt64, metric_a: UInt64, logical_timestamp_b: UInt64, node_b: UInt64, source_b: UInt64, metric_b: UInt64) {
        let key_a = distributed_merge_key(logical_timestamp_a, node_a, source_a, metric_a);
        let key_b = distributed_merge_key(logical_timestamp_b, node_b, source_b, metric_b);
        let winner = distributed_choose_first(key_a, node_a, key_b, node_b);

        if winner == 1 {
            return (key_a * 10) + 1;
        } else {
            if winner == 2 {
                return (key_b * 10) + 2;
            } else {
                return 0;
            }
        }
    }

    proc K::distributed_aggregate_sum_two(v_a: UInt64, v_b: UInt64) {
        return v_a + v_b;
    }

    proc K::distributed_aggregate_avg_two(v_a: UInt64, v_b: UInt64) {
        let total = distributed_aggregate_sum_two(v_a, v_b);
        return total / 2;
    }
}
