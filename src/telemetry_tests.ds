// Description:
//   xdv-telemetry: XDV-070 behavior tests.

forge XdvTelemetryTests {

    const TEST_PASS: UInt32 = 0;
    const TEST_FAIL: UInt32 = 1;

    const STATUS_OK: UInt32 = 0;

    proc K::expect_u32(actual: UInt32, expected: UInt32) {
        if actual == expected {
            return TEST_PASS;
        } else {
            return TEST_FAIL;
        }
    }

    proc K::expect_u64(actual: UInt64, expected: UInt64) {
        if actual == expected {
            return TEST_PASS;
        } else {
            return TEST_FAIL;
        }
    }

    proc K::combine(lhs: UInt32, rhs: UInt32) {
        if lhs == TEST_PASS {
            return rhs;
        } else {
            return TEST_FAIL;
        }
    }

    proc K::test_unified_metric_schema() {
        let m_k = XdvTelemetrySchema::K::metric_record_token(1, XdvTelemetryContracts::K::DOMAIN_K, 10, 100, 900, 77, 1, 1000, 2, 123, XdvTelemetryContracts::K::EXPOSURE_STRUCTURED);
        let m_q_ok = XdvTelemetrySchema::K::metric_record_token(2, XdvTelemetryContracts::K::DOMAIN_Q, 11, 101, 901, 55, 1, 1001, 3, 123, XdvTelemetryContracts::K::EXPOSURE_STRUCTURED);
        let m_q_raw = XdvTelemetrySchema::K::metric_record_token(3, XdvTelemetryContracts::K::DOMAIN_Q, 12, 102, 902, 44, 1, 1002, 3, 123, XdvTelemetryContracts::K::EXPOSURE_RAW_STATE);

        let tag = XdvTelemetrySchema::K::category_tag(XdvTelemetryContracts::K::CATEGORY_RESOURCE, XdvTelemetryContracts::K::DOMAIN_Q);
        let order_a = XdvTelemetrySchema::K::metric_order_key(1000, 1, 10, 1);
        let order_b = XdvTelemetrySchema::K::metric_order_key(1000, 1, 10, 1);

        let hash_a = XdvTelemetrySchema::K::metric_chain_hash(0, m_k);
        let hash_b = XdvTelemetrySchema::K::metric_chain_hash(0, m_k);

        let fault = XdvTelemetrySchema::K::fault_event_token(7, XdvTelemetryContracts::K::DOMAIN_PHI, 4, 903, 88, 1003, 555);

        let t1 = expect_u64(order_a, order_b);
        let t2 = expect_u64(hash_a, hash_b);

        let u1 = combine(t1, t2);

        if m_k == 0 {
            return TEST_FAIL;
        } else {
            if m_q_ok == 0 {
                return TEST_FAIL;
            } else {
                if m_q_raw == 0 {
                    if tag == 0 {
                        return TEST_FAIL;
                    } else {
                        if fault == 0 {
                            return TEST_FAIL;
                        } else {
                            return u1;
                        }
                    }
                } else {
                    return TEST_FAIL;
                }
            }
        }
    }

    proc K::test_deterministic_local_distributed_aggregation() {
        let flush_no = XdvTelemetryAggregation::K::local_flush_decision(100, 105, 10);
        let flush_yes = XdvTelemetryAggregation::K::local_flush_decision(100, 111, 10);

        let sum3 = XdvTelemetryAggregation::K::local_aggregate_sum3(3, 4, 5);
        let avg3 = XdvTelemetryAggregation::K::local_aggregate_avg3(3, 4, 5);
        let epoch = XdvTelemetryAggregation::K::local_buffer_epoch(XdvTelemetryContracts::K::DOMAIN_K, 120, 10);

        let merge_a = XdvTelemetryAggregation::K::distributed_merge_token(200, 1, 10, 1, 200, 2, 10, 1);
        let merge_b = XdvTelemetryAggregation::K::distributed_merge_token(200, 1, 10, 1, 200, 2, 10, 1);
        let merge_tie = XdvTelemetryAggregation::K::distributed_merge_token(200, 3, 10, 1, 200, 2, 10, 1);

        let dsum = XdvTelemetryAggregation::K::distributed_aggregate_sum_two(11, 13);
        let davg = XdvTelemetryAggregation::K::distributed_aggregate_avg_two(11, 13);

        let t1 = expect_u64(flush_no, XdvTelemetryAggregation::K::FLUSH_NO);
        let t2 = expect_u64(flush_yes, XdvTelemetryAggregation::K::FLUSH_YES);
        let t3 = expect_u64(sum3, 12);
        let t4 = expect_u64(avg3, 4);
        let t5 = expect_u64(merge_a, merge_b);
        let t6 = expect_u64(dsum, 24);
        let t7 = expect_u64(davg, 12);

        let u1 = combine(t1, t2);
        let u2 = combine(u1, t3);
        let u3 = combine(u2, t4);
        let u4 = combine(u3, t5);
        let u5 = combine(u4, t6);
        let u6 = combine(u5, t7);

        if epoch == 0 {
            return TEST_FAIL;
        } else {
            if merge_tie == 0 {
                return TEST_FAIL;
            } else {
                return u6;
            }
        }
    }

    proc K::test_capability_scoped_access_controls() {
        let tok = XdvTelemetryAccess::K::capability_token(33, 8, XdvTelemetryContracts::K::DOMAIN_Q, XdvTelemetryContracts::K::CAP_SCOPE_Q, 1000, 1100, 777);

        let allow_same = XdvTelemetryAccess::K::authorize_metric_read(8, XdvTelemetryContracts::K::DOMAIN_Q, XdvTelemetryContracts::K::CAP_SCOPE_Q, 1000, 1100, 1050, 8, XdvTelemetryContracts::K::DOMAIN_Q, 0);
        let deny_wrong_domain = XdvTelemetryAccess::K::authorize_metric_read(8, XdvTelemetryContracts::K::DOMAIN_Q, XdvTelemetryContracts::K::CAP_SCOPE_Q, 1000, 1100, 1050, 8, XdvTelemetryContracts::K::DOMAIN_K, 0);
        let deny_cross_tenant = XdvTelemetryAccess::K::authorize_metric_read(8, XdvTelemetryContracts::K::DOMAIN_Q, XdvTelemetryContracts::K::CAP_SCOPE_Q, 1000, 1100, 1050, 9, XdvTelemetryContracts::K::DOMAIN_Q, 0);
        let allow_cross_tenant = XdvTelemetryAccess::K::authorize_metric_read(8, XdvTelemetryContracts::K::DOMAIN_Q, XdvTelemetryContracts::K::CAP_SCOPE_Q, 1000, 1100, 1050, 9, XdvTelemetryContracts::K::DOMAIN_Q, 1);

        let deny_expired = XdvTelemetryAccess::K::authorize_metric_read(8, XdvTelemetryContracts::K::DOMAIN_Q, XdvTelemetryContracts::K::CAP_SCOPE_Q, 1000, 1100, 1201, 8, XdvTelemetryContracts::K::DOMAIN_Q, 0);

        let decision = XdvTelemetryAccess::K::access_decision_token(33, 8, XdvTelemetryContracts::K::DOMAIN_Q, allow_same, 1060);

        let t1 = expect_u32(allow_same, STATUS_OK);
        let t2 = expect_u32(deny_wrong_domain, XdvTelemetryContracts::K::STATUS_ACCESS_DENIED);
        let t3 = expect_u32(deny_cross_tenant, XdvTelemetryContracts::K::STATUS_ISOLATION_VIOLATION);
        let t4 = expect_u32(allow_cross_tenant, STATUS_OK);
        let t5 = expect_u32(deny_expired, XdvTelemetryContracts::K::STATUS_ACCESS_DENIED);

        let u1 = combine(t1, t2);
        let u2 = combine(u1, t3);
        let u3 = combine(u2, t4);
        let u4 = combine(u3, t5);

        if tok == 0 {
            return TEST_FAIL;
        } else {
            if decision == 0 {
                return TEST_FAIL;
            } else {
                return u4;
            }
        }
    }

    proc K::run_all_tests() {
        let t1 = test_unified_metric_schema();
        let t2 = combine(t1, test_deterministic_local_distributed_aggregation());
        return combine(t2, test_capability_scoped_access_controls());
    }
}
